# Template for the deploy env file. Copy to /opt/tools/.env ON THE CONTAINER
# (chmod 600, owned by deploy) — the real .env is NOT committed (.gitignore'd).
# CI overwrites these with immutable sha-<short> tags on each successful deploy;
# rolling back is a one-line edit here followed by `docker compose up -d`.
PROD_TAG=latest
STAGE_TAG=staging

# Restaurant Selector tool — point at your MongoDB. Include credentials here (this
# file is chmod 600 on the container and never committed), e.g.
#   MONGO_URI=mongodb://user:pass@192.168.0.20:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=Restaurants-DB
MONGO_COLLECTION=Restaurants-Collection
