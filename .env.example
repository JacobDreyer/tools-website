# Template for the deploy env file. Copy to /opt/tools/.env ON THE CONTAINER
# (chmod 600, owned by deploy) — the real .env is NOT committed (.gitignore'd).
# CI overwrites these with immutable sha-<short> tags on each successful deploy;
# rolling back is a one-line edit here followed by `docker compose up -d`.
PROD_TAG=latest
STAGE_TAG=staging
